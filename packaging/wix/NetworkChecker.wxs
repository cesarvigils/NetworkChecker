<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX Toolset v3 source file -> builds a true Windows Installer .msi.

  Prerequisites (on Windows): PyInstaller has already produced
  dist\NetworkChecker-GUI.exe and dist\networkchecker.exe, and WiX
  Toolset v3.11+ is installed (candle.exe / light.exe on PATH).

  Build (run from the repository root):
    candle -dSourceDir=dist packaging\wix\NetworkChecker.wxs -o build\wix\
    light build\wix\NetworkChecker.wixobj -ext WixUIExtension -o dist\NetworkChecker.msi

  Or simply run scripts\build_msi.bat, which does both steps.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="NetworkChecker"
           Language="1033"
           Version="1.0.0.0"
           Manufacturer="NetworkChecker Project"
           UpgradeCode="25A662EC-CFE2-40CE-A00D-52454D705377">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="Full Network Checker Interface Installer" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of NetworkChecker is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.exe" SourceFile="$(var.SourceDir)\NetworkChecker-GUI.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="NetworkChecker" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="NetworkChecker" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutables" Guid="8D3C1F6A-4B7E-4E2A-9C1D-6F0B2A5E7C94">
        <File Id="NetworkCheckerGuiExe" Source="$(var.SourceDir)\NetworkChecker-GUI.exe" KeyPath="yes" />
        <File Id="NetworkCheckerCliExe" Source="$(var.SourceDir)\networkchecker.exe" />
        <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no"
                     Part="last" Action="set" System="no" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="C4985ABA-D1BC-49FD-B821-ED6A01197A87">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="NetworkChecker"
                  Description="Full Network Checker Interface"
                  Target="[INSTALLFOLDER]NetworkChecker-GUI.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall NetworkChecker"
                  Target="[System64Folder]msiexec.exe"
                  Arguments="/x [ProductCode]"
                  Description="Uninstalls NetworkChecker" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\NetworkChecker" Name="installed"
                        Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="7B2E6D0C-2E63-4C1B-9B7D-3E2C6C6F0A21">
        <Shortcut Id="DesktopAppShortcut"
                  Name="NetworkChecker"
                  Description="Full Network Checker Interface"
                  Target="[INSTALLFOLDER]NetworkChecker-GUI.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\NetworkChecker" Name="desktop_shortcut"
                        Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="NetworkChecker" Level="1">
      <ComponentRef Id="MainExecutables" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <UIRef Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="packaging\wix\License.rtf" />
  </Product>
</Wix>
